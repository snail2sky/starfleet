[Unit]
Description=Starfleet Process Manager
Documentation=https://github.com/snail2sky/starfleet
After=network.target

[Service]
Type=simple
# Runs as root so per-process `user:` switching works (supervisord parity).
ExecStart=/usr/local/bin/starfleet serve -c /etc/starfleet/starfleet.yml --log /var/log/starfleet.log
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target